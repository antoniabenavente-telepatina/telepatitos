<!DOCTYPE html>
<html lang="es-CL">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>APS Inteligente Concón</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Serif:ital,wght@0,400;0,500;0,600;1,400&display=swap">
<style>
/* Layout: banda oscura (mar profundo de Concón) con la orden de exámenes como pieza viva; capítulos sobre papel claro, acento naranjo de la marca comunal. */
:root{
  --paper:#F2F4F3; --surface:#FFFFFF; --sunk:#E6EBEA;
  --ink:#16221F; --ink2:#47575A; --ink3:#69787A; --line:#D2DBDA;
  --navy:#155A8C; --navy-ink:#0E4469; --deep:#12262E; --deep2:#1A3540; --deep-fg:#EEF3F2; --deep-fg2:#A7BABD; --deep-line:#2A4A55;
  --sun:#EE7A3F; --sun-soft:#FCE9DF; --sun-ink:#8A3410; --on-sun:#2A0F02;
  --tp:#0B6B3D; --tp-soft:#E1F1E7; --tp-ink:#0A4F2E;
  --red:#B23A2B; --red-soft:#FBE9E6;
  --serif:"IBM Plex Serif",Georgia,"Times New Roman",serif;
  --sans:"IBM Plex Sans",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,"SFMono-Regular",Menlo,monospace;
  --ease:cubic-bezier(.2,0,0,1);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --paper:#091519; --surface:#0F2026; --sunk:#14292F;
  --ink:#E7EFEE; --ink2:#A5B8BA; --ink3:#81979A; --line:#203A41;
  --navy:#6FB3E6; --navy-ink:#A6D2F2; --deep:#06141A; --deep2:#0E242C; --deep-line:#1E3D47;
  --sun-soft:#3A2016; --sun-ink:#F8B48F;
  --tp:#5CC593; --tp-soft:#12301F; --tp-ink:#9BE0BC;
  --red:#F08A78; --red-soft:#3A1813;
  color-scheme:dark}}
:root[data-theme="dark"]{
  --paper:#091519; --surface:#0F2026; --sunk:#14292F;
  --ink:#E7EFEE; --ink2:#A5B8BA; --ink3:#81979A; --line:#203A41;
  --navy:#6FB3E6; --navy-ink:#A6D2F2; --deep:#06141A; --deep2:#0E242C; --deep-line:#1E3D47;
  --sun-soft:#3A2016; --sun-ink:#F8B48F;
  --tp:#5CC593; --tp-soft:#12301F; --tp-ink:#9BE0BC;
  --red:#F08A78; --red-soft:#3A1813;
  color-scheme:dark}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:calc(env(safe-area-inset-top,0px) + 70px)}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4,p,ul,ol,figure{margin:0}
ul,ol{padding:0;list-style:none}
img{max-width:100%;display:block}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
a{color:inherit}
:focus-visible{outline:2px solid var(--sun);outline-offset:3px;border-radius:6px}
.num{font-variant-numeric:tabular-nums}
.wrap{max-width:1180px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
section{padding-block:96px}
.eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--navy);display:flex;align-items:center;gap:10px}
.eyebrow::before{content:"";width:22px;height:2px;background:currentColor}
h2{font-family:var(--serif);font-weight:400;font-size:clamp(30px,4vw,46px);line-height:1.1;letter-spacing:-.015em;margin-top:18px;max-width:24ch;text-wrap:balance}
.lede{font-size:18px;color:var(--ink2);max-width:64ch;margin-top:16px;text-wrap:pretty}
.mark{background:linear-gradient(transparent 58%,var(--sun) 58%,var(--sun) 92%,transparent 92%);padding:0 2px;color:inherit}
.note{font-size:13px;color:var(--ink3)}
.dark{background:var(--deep);color:var(--deep-fg)}
.dark .eyebrow{color:var(--sun)}
.dark .lede{color:var(--deep-fg2)}
.dark .note{color:var(--deep-fg2)}

/* barra superior */
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--deep)}
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;background:var(--deep);color:var(--deep-fg);border-bottom:1px solid var(--deep-line)}
.top-in{display:flex;align-items:center;gap:16px;height:62px}
.top .tp-logo{height:22px;width:auto}
.top .chip{background:#fff;border-radius:8px;padding:4px 8px;display:flex}
.top .chip img{height:30px;width:auto}
.nav{display:flex;gap:2px;margin-left:auto;overflow-x:auto;scrollbar-width:none}
.nav::-webkit-scrollbar{display:none}
.nav a{flex:none;text-decoration:none;font-size:14px;color:var(--deep-fg2);padding:7px 11px;border-radius:999px;transition:background-color .15s var(--ease),color .15s var(--ease)}
.nav a:hover{color:var(--deep-fg)}
.nav a.on{background:var(--deep2);color:var(--deep-fg)}
.bar{position:absolute;left:0;bottom:-1px;height:2px;background:var(--sun);width:0}
@media (max-width:820px){.top .chip{display:none}}

/* portada */
.hero{padding-block:64px 0}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
.hero-grid>*{min-width:0}
.for{display:flex;align-items:center;gap:14px;flex-wrap:wrap;font-size:14px;color:var(--deep-fg2)}
.for .chip{background:#fff;border-radius:12px;padding:8px 12px;display:flex}
.for .chip img{height:46px;width:auto}
.name{font-family:var(--serif);font-size:clamp(20px,2.2vw,24px);color:var(--sun);margin-top:34px;letter-spacing:.01em}
.hero h1{font-family:var(--serif);font-weight:400;font-size:clamp(40px,5.6vw,72px);line-height:1.02;letter-spacing:-.025em;margin-top:10px;text-wrap:balance}
.hero h1 em{font-style:italic;color:var(--sun)}
.hero .lede{font-size:18px}
.cta{display:flex;gap:10px;flex-wrap:wrap;margin-top:30px}
.btn{display:inline-flex;align-items:center;gap:8px;height:46px;padding:0 18px;border-radius:10px;font-weight:600;font-size:15px;text-decoration:none;transition:background-color .15s var(--ease),box-shadow .15s var(--ease)}
.btn-sun{background:var(--sun);color:var(--on-sun)}
.btn-sun:hover{box-shadow:inset 0 0 0 99px rgba(0,0,0,.07)}
.btn-ghost{color:var(--deep-fg);box-shadow:inset 0 0 0 1.5px var(--deep-line)}
.btn-ghost:hover{background:var(--deep2)}

/* orden de examenes (pieza de portada) */
.order{background:#FBFCFD;color:#0D1C28;border-radius:18px;box-shadow:0 40px 80px -40px rgba(0,0,0,.7);overflow:hidden;font-size:14px}
.order-h{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:14px 18px;border-bottom:1px solid #DDE5EB;background:#fff}
.order-h b{font-weight:600}
.order-h span{font-family:var(--mono);font-size:11.5px;color:#61737F}
.order-p{padding:12px 18px;font-size:13px;color:#465868;border-bottom:1px dashed #DDE5EB}
.order ul{padding:6px 10px 4px}
.order li{display:grid;grid-template-columns:22px 1fr auto;gap:10px;align-items:center;padding:7px 8px;border-radius:8px;transition:background-color .3s var(--ease),opacity .3s var(--ease)}
.order li .bx{width:16px;height:16px;border-radius:4px;border:1.5px solid #0D1C28;display:grid;place-items:center}
.order li .bx svg{width:12px;height:12px}
.order li .why{font-size:11.5px;color:#9A2F22;font-family:var(--mono);opacity:0;transition:opacity .3s var(--ease);text-align:right}
.order li.off{opacity:.75;background:#FBEDEA}
.order li.off .t{text-decoration:line-through;text-decoration-color:#B23A2B;text-decoration-thickness:2px;color:#6A7B89}
.order li.off .why{opacity:1}
.order li.off .bx{border-color:#B23A2B;background:#B23A2B;color:#fff}
.order li.keep .bx{background:#0B5E3A;border-color:#0B5E3A;color:#fff}
.order-f{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 18px;background:#F1F4F6;border-top:1px solid #DDE5EB;flex-wrap:wrap}
.order-f .cnt{font-family:var(--serif);font-size:24px}
.order-f .cnt small{font-family:var(--sans);font-size:12.5px;color:#61737F;margin-left:6px}
.order-f button{height:38px;padding:0 14px;border-radius:9px;background:#0B5E3A;color:#fff;font-weight:600;font-size:14px}
.order-f button[disabled]{opacity:.55;cursor:default}
.hstats{display:grid;grid-template-columns:repeat(4,1fr);margin-top:64px;border-top:1px solid var(--deep-line)}
.hstats>div{padding:24px 20px 30px 0;min-width:0}
.hstats>div+div{padding-left:20px;border-left:1px solid var(--deep-line)}
.hstats b{display:block;font-family:var(--serif);font-weight:400;font-size:34px;letter-spacing:-.02em}
.hstats span{font-size:14px;color:var(--deep-fg2)}
.src{font-size:12.5px;color:var(--deep-fg2);padding-bottom:28px}
@media (max-width:960px){.hero-grid{grid-template-columns:1fr}.hstats{grid-template-columns:1fr 1fr}.hstats>div:nth-child(3){padding-left:0;border-left:0}.hstats>div:nth-child(n+3){border-top:1px solid var(--deep-line)}}

/* desafio */
.pains{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:48px;border-top:1px solid var(--line)}
.pain{padding:26px 26px 30px 0;border-bottom:1px solid var(--line);min-width:0}
.pain:not(:nth-child(3n+1)){padding-left:26px;border-left:1px solid var(--line)}
.pain .k{font-family:var(--mono);font-size:12px;color:var(--ink3);letter-spacing:.06em;text-transform:uppercase}
.pain h3{font-family:var(--serif);font-weight:500;font-size:21px;line-height:1.25;margin-top:10px}
.pain p{color:var(--ink2);margin-top:8px;font-size:15px}
.pain.big{background:var(--sun-soft)}
.quote{margin-top:48px;display:grid;grid-template-columns:auto 1fr;gap:24px;align-items:start;max-width:860px}
.quote .q{font-family:var(--serif);font-size:72px;line-height:.8;color:var(--sun)}
.quote p{font-family:var(--serif);font-size:clamp(22px,2.6vw,30px);line-height:1.3;font-style:italic}
.quote small{display:block;font-family:var(--sans);font-style:normal;font-size:14px;color:var(--ink3);margin-top:12px}
@media (max-width:900px){.pains{grid-template-columns:1fr}.pain,.pain:not(:nth-child(3n+1)){padding:22px 0;border-left:0}}

/* como funciona */
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:44px}
.step{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:24px;min-width:0}
.step .n{width:30px;height:30px;border-radius:50%;background:var(--tp);color:var(--paper);display:grid;place-items:center;font-weight:600;font-size:14px}
.step h3{font-family:var(--serif);font-weight:500;font-size:21px;margin-top:16px;line-height:1.25}
.step p{color:var(--ink2);margin-top:8px;font-size:15px}
.rules{margin-top:28px;background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:24px}
.rules h3{font-size:15px;font-weight:600}
.rules-g{display:grid;grid-template-columns:repeat(2,1fr);gap:10px 28px;margin-top:14px}
.rule{display:grid;grid-template-columns:auto 1fr;gap:12px;font-size:14.5px;color:var(--ink2);padding:10px 0;border-top:1px solid var(--line);min-width:0}
.rule code{font-family:var(--mono);font-size:12px;color:var(--tp-ink);background:var(--tp-soft);padding:2px 8px;border-radius:6px;white-space:nowrap;height:max-content}
@media (max-width:900px){.steps{grid-template-columns:1fr}.rules-g{grid-template-columns:1fr}}

/* demo */
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-top:40px}
.tabs button{padding:10px 16px;border-radius:12px;text-align:left;box-shadow:inset 0 0 0 1px var(--deep-line);transition:background-color .15s var(--ease),box-shadow .15s var(--ease);min-width:0}
.tabs button small{display:block;font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--deep-fg2)}
.tabs button b{display:block;font-weight:600;font-size:15px;margin-top:2px}
.tabs button[aria-selected="true"]{background:var(--sun);color:var(--on-sun);box-shadow:none}
.tabs button[aria-selected="true"] small{color:var(--on-sun);opacity:.75}
.stage{margin-top:18px;background:var(--surface);color:var(--ink);border-radius:20px;overflow:hidden}
.stage-h{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center;padding:16px 22px;border-bottom:1px solid var(--line)}
.stage-h b{font-weight:600}
.stage-h span{font-size:14px;color:var(--ink2)}
.stage-g{display:grid;grid-template-columns:.9fr 1fr 1.1fr}
.stage-g>div{padding:20px 22px;min-width:0}
.stage-g>div+div{border-left:1px solid var(--line)}
.col-t{font-family:var(--mono);font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink3);margin-bottom:12px;display:flex;align-items:center;gap:8px}
.col-t i{width:7px;height:7px;border-radius:50%;background:var(--red);display:inline-block;animation:pulse 1.6s infinite}
@keyframes pulse{50%{opacity:.25}}
.conv p{font-size:14.5px;margin-bottom:10px}
.conv p b{display:block;font-family:var(--mono);font-size:11px;font-weight:500;color:var(--ink3);letter-spacing:.04em;text-transform:uppercase}
.plan li{display:grid;grid-template-columns:auto 1fr;gap:10px;padding:8px 10px;border-radius:9px;font-size:14.5px;align-items:start;transition:background-color .3s var(--ease)}
.plan li+li{margin-top:4px}
.plan .tag{font-family:var(--mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;padding:2px 6px;border-radius:5px;background:var(--sunk);color:var(--ink2);margin-top:2px}
.plan li.off{background:var(--red-soft)}
.plan li.off span:last-child{text-decoration:line-through;text-decoration-color:var(--red);color:var(--ink3)}
.plan li.new{background:var(--tp-soft)}
.plan li.new .tag{background:var(--tp);color:var(--paper)}
.alerts{display:grid;gap:10px}
.al{border:1px solid var(--line);border-radius:14px;padding:14px 16px;background:var(--surface);transition:opacity .3s var(--ease),border-color .3s var(--ease)}
.al.crit{border-color:var(--red)}
.al .at{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.pill{font-family:var(--mono);font-size:10.5px;letter-spacing:.05em;text-transform:uppercase;padding:3px 8px;border-radius:999px;white-space:nowrap}
.p-cdss{background:var(--tp-soft);color:var(--tp-ink)}
.p-cass{background:var(--sun-soft);color:var(--sun-ink)}
.p-crit{background:var(--red-soft);color:var(--red)}
.al h4{font-size:15px;font-weight:600;margin-top:8px;line-height:1.3}
.al p{font-size:14px;color:var(--ink2);margin-top:4px}
.al .ref{font-size:12px;color:var(--ink3);margin-top:8px}
.al .act{display:flex;gap:8px;margin-top:12px}
.al .act button{height:34px;padding:0 14px;border-radius:8px;font-size:13.5px;font-weight:600}
.al .yes{background:var(--tp);color:var(--paper)}
.al .no{box-shadow:inset 0 0 0 1px var(--line);color:var(--ink2)}
.al.done{opacity:.6}
.al.done .act{display:none}
.al .st{display:none;font-size:13px;font-weight:600;color:var(--tp);margin-top:10px}
.al.done .st{display:block}
.tally{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);background:var(--sunk)}
.tally>div{padding:14px 22px;min-width:0}
.tally>div+div{border-left:1px solid var(--line)}
.tally b{font-family:var(--serif);font-weight:400;font-size:28px;display:block;line-height:1.1}
.tally span{font-size:13px;color:var(--ink2)}
.dx{padding:12px 22px;font-size:13.5px;color:var(--ink2);border-top:1px solid var(--line)}
.dx b{color:var(--ink);font-weight:600}
.shots{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:28px}
.shots figure{min-width:0}
.shots img{border-radius:14px;width:100%;height:auto}
.shots figcaption{font-size:13px;color:var(--deep-fg2);margin-top:8px}
@media (max-width:980px){.stage-g{grid-template-columns:1fr}.stage-g>div+div{border-left:0;border-top:1px solid var(--line)}.tally{grid-template-columns:1fr 1fr}.tally>div:nth-child(3){border-left:0}.tally>div:nth-child(n+3){border-top:1px solid var(--line)}.shots{grid-template-columns:1fr}}

/* catalogo de alertas */
.cat{display:grid;grid-template-columns:.95fr 1.05fr;gap:28px;margin-top:44px;align-items:start}
.cat>*{min-width:0}
.cat-l h3{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink3);margin:18px 0 8px}
.cat-l h3:first-child{margin-top:0}
.cat-l button{display:flex;justify-content:space-between;gap:12px;width:100%;text-align:left;padding:12px 14px;border-radius:10px;font-size:15px;transition:background-color .15s var(--ease)}
.cat-l button:hover{background:var(--sunk)}
.cat-l button[aria-selected="true"]{background:var(--surface);box-shadow:inset 0 0 0 1px var(--line),0 6px 18px -12px rgba(0,0,0,.4)}
.cat-l button span:last-child{font-family:var(--mono);font-size:11px;color:var(--ink3);white-space:nowrap;align-self:center}
.cat-r{position:sticky;top:90px;background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:26px}
.cat-r h4{font-family:var(--serif);font-weight:500;font-size:26px;line-height:1.2;margin-top:12px}
.cat-r dl{margin:18px 0 0;display:grid;gap:14px}
.cat-r dt{font-family:var(--mono);font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink3)}
.cat-r dd{margin:4px 0 0;color:var(--ink2);font-size:15px}
.card-md{margin-top:20px;background:var(--sunk);border-radius:14px;padding:16px}
.card-md .al{background:var(--surface)}
@media (max-width:900px){.cat{grid-template-columns:1fr}.cat-r{position:static}}

/* evidencia */
.ev-k{display:grid;grid-template-columns:repeat(4,1fr);margin-top:44px;border-top:1px solid var(--line)}
.ev-k>div{padding:22px 20px 26px 0;min-width:0}
.ev-k>div+div{padding-left:20px;border-left:1px solid var(--line)}
.ev-k b{display:block;font-family:var(--serif);font-weight:400;font-size:40px;letter-spacing:-.02em;line-height:1.1}
.ev-k span{font-size:14px;color:var(--ink2)}
.ev-g{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:28px}
.ev-g>*{min-width:0}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:24px}
.panel h3{font-family:var(--serif);font-weight:500;font-size:21px;line-height:1.25}
.panel .sub{font-size:14px;color:var(--ink2);margin-top:6px}
.slope{width:100%;height:auto;margin-top:12px}
.slope text{font-family:var(--sans);fill:var(--ink2)}
.dose{margin-top:20px;display:grid;gap:14px}
.dose div{display:grid;grid-template-columns:150px 1fr 60px;gap:12px;align-items:center;font-size:14px}
.dose i{display:block;height:14px;border-radius:4px;background:var(--tp)}
.dose b{font-family:var(--mono);font-weight:500;font-size:13.5px;text-align:right}
.fam{margin-top:18px;display:grid;gap:10px}
.fam div{display:grid;grid-template-columns:minmax(0,190px) 1fr 62px;gap:12px;align-items:center}
.fam span{font-size:14px;line-height:1.25}
.fam span small{display:block;font-size:12px;color:var(--ink3)}
.fam i{display:block;height:14px;border-radius:4px;background:var(--navy)}
.fam b{font-family:var(--mono);font-weight:500;font-size:13.5px;text-align:right}
.start{margin-top:20px;display:grid;grid-template-columns:auto 1fr;gap:20px;align-items:center;background:var(--sun-soft);border-radius:18px;padding:22px 24px}
.start b{font-family:var(--serif);font-weight:400;font-size:44px;line-height:1;color:var(--sun-ink)}
.start p{color:var(--ink);font-size:15.5px}
.net{margin-top:20px;display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.net>div{border-top:2px solid var(--ink);padding-top:12px;min-width:0}
.net b{font-family:var(--serif);font-weight:400;font-size:28px;display:block}
.net span{font-size:14px;color:var(--ink2)}
